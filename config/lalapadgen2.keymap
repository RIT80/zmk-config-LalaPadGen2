#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <dt-bindings/zmk/oskey.h>
#include <behaviors/oskey.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 0>, <&mo 0>;
        };

        tog_on: tog_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_ON";
            #binding-cells = <1>;
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        os_sel: os_selector {
            compatible = "zmk,behavior-os-selector";
            #binding-cells = <1>;
        };

        /* Ctrl on Windows/Linux, Cmd (GUI) on macOS */

        ok_ctrl: os_key_ctrl {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*          Win          Mac         Lin  */

            bindings = <&kp LCTRL>, <&kp LGUI>, <&kp LCTRL>;
        };

        /* Alt on Windows/Linux, Option (Alt) on macOS — same key, shown for clarity */

        ok_win: os_key_win {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*          Win          Mac        Lin  */

            bindings = <&kp LGUI>, <&kp LCTRL>, <&kp LGUI>;
        };

        os_win_up: os_win_up {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(UP)>, <&kp LC(UP)>, <&kp LG(UP)>;

            label = "OS_WIN_UP";
        };

        os_win_right: os_win_right {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT)>, <&kp LC(RIGHT)>, <&kp LG(RIGHT)>;

            label = "OS_WIN_RIGHT";
        };

        os_win_left: os_win_left {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT)>, <&kp LC(LEFT)>, <&kp LG(LEFT)>;

            label = "OS_WIN_LEFT";
        };

        os_win_down: os_win_down {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(DOWN)>, <&kp LC(DOWN)>, <&kp LG(DOWN)>;

            label = "OS_WIN_DOWN";
        };

        os_prt_sc_clipboard: os_prt_sc_clipboard {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings =
                <&kp LG(LS(S))>,
                <&kp LG(LS(LC(NUMBER_4 )))>,
                <&kp LG(LS(S))>;

            label = "OS_PRINT_SCREN_CLIPBOARD";
        };

        ok_next_tab: os_key_next_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac              Lin  */

            bindings = <&kp LC(TAB)>, <&kp LG(TAB)>, <&kp LC(TAB)>;
        };

        ok_prev_tab: os_key_prev_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac              Lin  */

            bindings = <&kp LS(LC(TAB))>, <&kp LG(LS(TAB))>, <&kp LS(LC(TAB))>;
        };

        ok_mt2_win_l: ok_mt2_win_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <1000>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&ok_win>, <&kp>;

            label = "OK_MT2_WIN_L";
            hold-trigger-key-positions = <5 6 7 8 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 37 38 39 40 41 36>;
            hold-trigger-on-release;
        };

        ok_mt2_ctrl_l: ok_mt2_ctrl_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <1000>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&ok_ctrl>, <&kp>;

            label = "OK_MT2_CTRL_L";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 37 38 39 40 41 36>;
            hold-trigger-on-release;
        };

        ok_mt2_win_r: ok_mt2_win_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <1000>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&ok_win>, <&kp>;

            label = "OK_MT2_WIN_R";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
        };

        ok_mt2_ctrl_r: ok_mt2_ctrl_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <1000>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&ok_ctrl>, <&kp>;

            label = "OK_MT2_CTRL_R";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
        };

        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <1000>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            label = "HRM_L";
            hold-trigger-key-positions = <5 6 7 8 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 37 38 39 40 41 36>;
            hold-trigger-on-release;
        };

        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <1000>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            label = "HRM_R";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <0>;
        };

        COMBO_LSHIFT {
            bindings = <&kp LSHIFT>;
            key-positions = <21 20>;
            layers = <0>;
        };

        combo_double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <7 8>;
            layers = <0>;
        };

        combo_single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <17 18>;
            layers = <0>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <8 9>;
            layers = <0>;
        };
    };

    macros {
        bt_linux: bt_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 500>, <&os_sel OS_LIN>;

            label = "BT_LINUX";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&macro_wait_time 500>, <&os_sel OS_WIN>;

            label = "BT_WIN";
        };

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&macro_wait_time 500>, <&os_sel OS_MAC>;

            label = "BT_MAC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q               &kp W                 &kp E                  &kp R             &kp T                                   &kp Y        &kp U             &kp I                 &kp O              &kp P
&ok_mt2_ctrl_l 0 A  &ok_mt2_win_l 0 S     &hrm_l LEFT_ALT D      &hrm_l LSHFT F    &kp G                                   &kp H        &hrm_r RSHIFT J   &hrm_r RIGHT_ALT K    &ok_mt2_win_r 0 L  &ok_mt2_ctrl_r 0 SEMI
&mt2 LEFT_SHIFT Z   &kp X                 &kp C                  &kp V             &kp B                                   &kp N        &kp M             &kp COMMA             &kp PERIOD         &mt2 RIGHT_SHIFT SLASH
&ok_ctrl            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &lt 1 LANGUAGE_2  &lt 2 SPACE  &kp DELETE  &kp BACKSPACE  &lt 2 ENTER  &lt 1 LANGUAGE_1  &os_prt_sc_clipboard  &kp TAB            &kp ESCAPE
                    &kp ESCAPE            &kp RIGHT              &kp DOWN          &kp LEFT     &kp UP      &kp UP         &kp LEFT     &kp DOWN          &kp RIGHT             &kp ESCAPE
&mkp LCLK           &mkp RCLK             &mkp MCLK                                                                                                       &mkp LCLK             &mkp RCLK          &mkp MCLK
&mkp MB4            &mkp MB5              &kp LG(TAB)            &kp LG(D)         &kp LCTRL                               &mkp MB4     &mkp MB5          &kp LG(TAB)           &kp LG(D)          &kp LCTRL
            >;
        };

        ARROW_LAYER {
            bindings = <
&trans  &kp LC(LS(TAB))  &os_win_up    &kp LC(TAB)    &trans                  &kp HOME  &mkp MB4  &kp UP    &mkp MB5   &kp PAGE_UP
&trans  &os_win_left     &os_win_down  &os_win_right  &trans                  &kp END   &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN
&trans  &trans           &trans        &trans         &trans                  &trans    &trans    &trans    &trans     &trans
&trans  &trans           &trans        &trans         &trans  &trans  &trans  &trans    &trans    &trans    &trans     &trans
        &trans           &trans        &trans         &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans           &trans                                                                   &trans    &trans     &trans
&trans  &trans           &trans        &trans         &trans                  &trans    &trans    &trans    &trans     &trans
            >;

            label = "arrow";
        };

        SUB_LAYER {
            bindings = <
&kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp EXCL    &kp LEFT_BRACE    &kp RIGHT_BRACE                    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp EQUAL
&kp AT            &kp HASH           &kp DOLLAR  &kp LEFT_BRACKET  &kp RIGHT_BRACKET                  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS      &kp MINUS
&kp PERCENT       &kp AMPERSAND      &kp PIPE    &kp CARET         &kp TILDE                          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK  &kp SLASH
&kp GRAVE         &trans             &trans      &trans            &trans             &trans  &trans  &trans        &trans        &kp COMMA     &kp PERIOD    &kp BACKSLASH
                  &trans             &trans      &trans            &trans             &trans  &trans  &trans        &trans        &trans        &trans
&trans            &trans             &trans                                                                                       &trans        &trans        &trans
&trans            &trans             &trans      &trans            &trans                             &trans        &trans        &trans        &trans        &trans
            >;

            label = "sub";
        };

        SYSTEM_LAYER {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                 &out OUT_TOG                   &bt_linux                      &bt_win                        &bt_mac                        &none
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10                &sys_reset                     &bootloader                    &bt BT_CLR                     &none                          &none
&kp F11  &kp F12  &none   &none   &none                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&none    &none    &none   &none   &none    &none  &none  &none                          &none                          &none                          &none                          &none
         &none    &none   &none   &none    &none  &none  &none                          &none                          &none                          &none
&none    &none    &none                                                                                                &none                          &none                          &none
&none    &none    &none   &none   &none                  &none                          &none                          &none                          &none                          &none
            >;

            label = "system";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
