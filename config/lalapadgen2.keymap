#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <dt-bindings/zmk/oskey.h>
#include <behaviors/oskey.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 0>, <&mo 0>;
        };

        tog_on: tog_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_ON";
            #binding-cells = <1>;
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        os_sel: os_selector {
            compatible = "zmk,behavior-os-selector";
            #binding-cells = <1>;
        };

        /* Ctrl on Windows/Linux, Cmd (GUI) on macOS */

        ok_ctrl: os_key_ctrl {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*          Win          Mac         Lin  */

            bindings = <&kp LCTRL>, <&kp LGUI>, <&kp LCTRL>;
        };

        /* Alt on Windows/Linux, Option (Alt) on macOS — same key, shown for clarity */

        ok_win: os_key_win {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*          Win          Mac        Lin  */

            bindings = <&kp LGUI>, <&kp LCTRL>, <&kp LGUI>;
        };

        os_win_up: os_win_up {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(UP)>, <&kp LC(UP)>, <&kp LG(UP)>;

            label = "OS_WIN_UP";
        };

        os_win_right: os_win_right {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT)>, <&kp LC(RIGHT)>, <&kp LG(RIGHT)>;

            label = "OS_WIN_RIGHT";
        };

        os_win_left: os_win_left {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT)>, <&kp LC(LEFT)>, <&kp LG(LEFT)>;

            label = "OS_WIN_LEFT";
        };

        os_win_down: os_win_down {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(DOWN)>, <&kp LC(DOWN)>, <&kp LG(DOWN)>;

            label = "OS_WIN_DOWN";
        };

        os_prt_sc_clipboard: os_prt_sc_clipboard {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings =
                <&kp LG(LS(S))>,
                <&kp LG(LS(LC(NUMBER_4 )))>,
                <&kp LG(LS(S))>;

            label = "OS_PRINT_SCREN_CLIPBOARD";
        };

        ok_next_tab: os_key_next_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac              Lin  */

            bindings = <&kp LC(TAB)>, <&kp LG(TAB)>, <&kp LC(TAB)>;
        };

        ok_prev_tab: os_key_prev_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac              Lin  */

            bindings = <&kp LS(LC(TAB))>, <&kp LG(LS(TAB))>, <&kp LS(LC(TAB))>;
        };

        ok_mt2_win: ok_mt2_win {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&ok_win>, <&kp>;

            label = "OK_MT2_WIN";
        };

        ok_mt2_ctrl: ok_mt2_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&ok_ctrl>, <&kp>;

            label = "OK_MT2_CTRL";
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <0>;
        };

        COMBO_LSHIFT {
            bindings = <&kp LSHIFT>;
            key-positions = <21 20>;
            layers = <0>;
        };

        combo_double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <7 8>;
            layers = <0 2>;
        };

        combo_single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <17 18>;
            layers = <0 2>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <8 9>;
            layers = <0>;
        };
    };

    macros {
        bt_linux: bt_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 500>, <&os_sel OS_LIN>;

            label = "BT_LINUX";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&macro_wait_time 500>, <&os_sel OS_WIN>;

            label = "BT_WIN";
        };

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&macro_wait_time 500>, <&os_sel OS_MAC>;

            label = "BT_MAC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W            &kp E            &kp R             &kp T                                   &kp Y        &kp U             &kp I                 &kp O            &kp P
&ok_mt2_ctrl 0 A   &ok_mt2_win 0 S  &mt2 LEFT_ALT D  &mt2 LSHFT F      &kp G                                   &kp H        &mt2 RSHIFT J     &mt2 RIGHT_ALT K      &ok_mt2_win 0 L  &ok_mt2_ctrl 0 SEMI
&mt2 LEFT_SHIFT Z  &kp X            &kp C            &kp V             &kp B                                   &kp N        &kp M             &kp COMMA             &kp PERIOD       &kp SLASH
&ok_ctrl           &ok_win          &kp LEFT_ALT     &lt 1 LANGUAGE_2  &lt 2 SPACE  &kp DELETE  &kp BACKSPACE  &lt 2 ENTER  &lt 1 LANGUAGE_1  &os_prt_sc_clipboard  &ok_ctrl         &kp RIGHT_SHIFT
                   &kp ESCAPE       &kp RIGHT        &kp DOWN          &kp LEFT     &kp UP      &kp UP         &kp LEFT     &kp DOWN          &kp RIGHT             &kp ESCAPE
&mkp LCLK          &mkp RCLK        &mkp MCLK                                                                                                 &mkp LCLK             &mkp RCLK        &mkp MCLK
&mkp MB4           &mkp MB5         &kp LG(TAB)      &kp LG(D)         &kp LCTRL                               &mkp MB4     &mkp MB5          &kp LG(TAB)           &kp LG(D)        &kp LCTRL
            >;
        };

        ARROW_LAYER {
            bindings = <
&trans  &kp LC(LS(TAB))  &os_win_up    &kp LC(TAB)    &trans                  &trans  &mkp MB4  &kp UP    &mkp MB5   &trans
&trans  &os_win_left     &os_win_down  &os_win_right  &trans                  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans  &trans           &trans        &trans         &trans                  &trans  &trans    &trans    &trans     &trans
&trans  &trans           &trans        &trans         &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans
        &trans           &trans        &trans         &trans  &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans           &trans                                                                 &trans    &trans     &trans
&trans  &trans           &trans        &trans         &trans                  &trans  &trans    &trans    &trans     &trans
            >;

            label = "arrow";
        };

        SYMBOL_LAYER {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7      &kp NUMBER_8  &kp NUMBER_9      &kp NUMBER_0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5                        &kp GRAVE     &kp BACKSLASH     &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp F6        &kp F7        &kp F8        &kp F9        &kp F10                       &kp SEMI      &kp SINGLE_QUOTE  &none         &kp F11           &kp F12
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans        &trans            &trans        &trans            &trans
              &trans        &trans        &trans        &trans        &trans  &trans  &trans        &trans            &trans        &trans
&trans        &trans        &trans                                                                                    &trans        &trans            &trans
&trans        &trans        &trans        &trans        &trans                        &trans        &trans            &trans        &trans            &trans
            >;

            label = "symbol";
        };

        SYSTEM_LAYER {
            bindings = <
&none           &none       &none       &sys_reset  &none                      &out OUT_BLE                   &bt_linux                      &bt_win                        &bt_mac                        &none
&bt BT_CLR_ALL  &sys_reset  &none       &none       &none                      &out OUT_USB                   &none                          &none                          &none                          &none
&none           &none       &bt BT_CLR  &none       &bootloader                &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&none           &none       &none       &none       &none        &none  &none  &none                          &none                          &none                          &none                          &none
                &none       &none       &none       &none        &none  &none  &none                          &none                          &none                          &none
&none           &none       &none                                                                                                            &none                          &none                          &none
&none           &none       &none       &none       &none                      &none                          &none                          &none                          &none                          &none
            >;

            label = "system";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };
};
