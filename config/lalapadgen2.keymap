#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <dt-bindings/zmk/oskey.h>
#include <behaviors/oskey.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 0>, <&mo 0>;
        };

        tog_on: tog_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_ON";
            #binding-cells = <1>;
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "TOG_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        os_sel: os_selector {
            compatible = "zmk,behavior-os-selector";
            #binding-cells = <1>;
        };

        /* Ctrl on Windows/Linux, Cmd (GUI) on macOS */

        ok_ctrl: os_key_ctrl {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*          Win          Mac         Lin  */

            bindings = <&kp LCTRL>, <&kp LGUI>, <&kp LCTRL>;
        };

        /* Alt on Windows/Linux, Option (Alt) on macOS — same key, shown for clarity */

        ok_win: os_key_win {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*          Win          Mac        Lin  */

            bindings = <&kp LGUI>, <&kp LCTRL>, <&kp LGUI>;
        };

        ok_win_up: ok_win_up {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(UP)>, <&kp LC(UP)>, <&kp LG(UP)>;

            label = "OK_WIN_UP";
        };

        os_win_right: os_win_right {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT)>, <&kp LC(RIGHT)>, <&kp LG(RIGHT)>;

            label = "OS_WIN_RIGHT";
        };

        os_win_left: os_win_left {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT)>, <&kp LC(LEFT)>, <&kp LG(LEFT)>;

            label = "OS_WIN_LEFT";
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        COMBO_LSHIFT {
            bindings = <&kp LSHIFT>;
            key-positions = <21 20>;
        };
    };

    macros {
        bt_linux: bt_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on 0>,
                <&macro_wait_time 200>,
                <&to 0>;

            label = "BT_LINUX";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 0>,
                <&macro_wait_time 200>,
                <&to 0>;

            label = "BT_WIN";
        };

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 2>,
                <&macro_wait_time 500>,
                <&tog_on 0>,
                <&macro_wait_time 200>,
                <&to 0>;

            label = "BT_MAC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W      &kp E         &kp R           &kp T                                      &kp Y        &kp U           &kp I          &kp O       &kp P
&kp A              &kp S      &kp D         &kp F           &kp G                                      &kp H        &kp J           &kp K          &kp L       &kp MINUS
&mt2 LEFT_SHIFT Z  &kp X      &kp C         &kp V           &kp B                                      &kp N        &kp M           &kp COMMA      &kp PERIOD  &kp SLASH
&ok_ctrl           &ok_win    &kp LEFT_ALT  &kp LANGUAGE_2  &lt 1 SPACE  &kp LSHFT  &backspace_delete  &lt 2 ENTER  &kp LANGUAGE_1  &kp BACKSLASH  &kp EQUAL   &kp SEMICOLON
                   &none      &kp RIGHT     &kp DOWN        &kp LEFT     &kp UP     &kp UP             &kp LEFT     &kp DOWN        &kp RIGHT      &none
&mkp LCLK          &mkp RCLK  &mkp MCLK                                                                                             &mkp LCLK      &mkp RCLK   &mkp MCLK
&mkp MB4           &mkp MB5   &kp LG(TAB)   &kp LG(D)       &kp LCTRL                                  &mkp MB4     &mkp MB5        &kp LG(TAB)    &kp LG(D)   &kp LCTRL
            >;
        };

        SYMBOL_LAYER {
            bindings = <
&trans           &trans       &trans     &trans      &trans                       &kp GRAVE  &kp PIPE       &kp PLUS      &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR  &kp PERCENT                  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp PLUS         &kp MINUS    &kp ASTRK  &kp SLASH   &kp EQUAL                    &kp TILDE  &trans         &kp EQUAL     &kp LEFT_BRACE        &kp RIGHT_BRACE
&trans           &trans       &trans     &trans      &trans       &trans  &trans  &trans     &trans         &trans        &trans                &trans
                 &trans       &trans     &trans      &trans       &trans  &trans  &trans     &trans         &trans        &trans
&trans           &trans       &trans                                                                        &trans        &trans                &trans
&trans           &trans       &trans     &trans      &trans                       &trans     &trans         &trans        &trans                &trans
            >;

            label = "symbol";
        };

        NUMBER_LAYER {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5                  &kp N6  &kp N7  &kp N8  &kp N9   &kp N0
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                                                  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans   &trans
            >;

            label = "number";
        };

        SYSTEM_LAYER {
            bindings = <
&none  &none       &none       &sys_reset  &none                      &kp N0          &kp N1          &kp N2          &kp N3          &kp N4
&none  &sys_reset  &none       &none       &none                      &none           &none           &none           &none           &none
&none  &none       &bt BT_CLR  &none       &bootloader                &zip_dyn_scale  &zip_dyn_scale  &zip_dyn_scale  &zip_dyn_scale  &zip_dyn_scale
&none  &none       &none       &none       &none        &none  &none  &none           &none           &none           &none           &none
       &none       &none       &none       &none        &none  &none  &none           &none           &none           &none
&none  &none       &none                                                                              &none           &none           &none
&none  &none       &none       &none       &none                      &none           &none           &none           &none           &none
            >;

            label = "system";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
